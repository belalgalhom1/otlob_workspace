generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pgcrypto, pg_trgm]
}

model PlatformSetting {
  id                          String  @id @default("default")
  currency                    String  @default("EGP")
  defaultCommissionRate       Int     @default(10)
  deliveryCommissionRate      Int     @default(20)
  driverManagerCommissionRate Int     @default(10)
  defaultTaxRate              Int     @default(14)
  minOrderAmount              Int     @default(0)
  baseDeliveryFee             Int     @default(15)
  extraVendorDeliveryFee      Int     @default(10)
  pricePerKm                  Int     @default(3)
  pricePerKmBicycle           Int     @default(2)
  pricePerKmMotorcycle        Int     @default(3)
  pricePerKmCar               Int     @default(5)
  pricePerKmVan               Int     @default(8)
  pricePerKmTruck             Int     @default(12)
  pricePerKmMotorTricycle     Int     @default(4)
  maxDeliveryFee              Int     @default(0)
  // Absolute customer-facing delivery-fee floor (EGP, whole pounds). Applied
  // after the per-vehicle min/max matrix, so a vehicle override still wins.
  minDeliveryFee              Int     @default(15)
  minDeliveryFeeBicycle       Int     @default(15)
  maxDeliveryFeeBicycle       Int     @default(0)
  minDeliveryFeeMotorcycle    Int     @default(15)
  maxDeliveryFeeMotorcycle    Int     @default(0)
  minDeliveryFeeCar           Int     @default(15)
  maxDeliveryFeeCar           Int     @default(0)
  minDeliveryFeeVan           Int     @default(15)
  maxDeliveryFeeVan           Int     @default(0)
  minDeliveryFeeTruck         Int     @default(15)
  maxDeliveryFeeTruck         Int     @default(0)
  minDeliveryFeeMotorTricycle Int     @default(15)
  maxDeliveryFeeMotorTricycle Int     @default(0)

  allowBicycle       Boolean @default(true)
  allowMotorcycle    Boolean @default(true)
  allowCar           Boolean @default(true)
  allowVan           Boolean @default(true)
  allowTruck         Boolean @default(true)
  allowMotorTricycle Boolean @default(true)

  minOrderKm                            Int       @default(0)
  minDistanceFixedPrice                 Int       @default(0)
  maxDeliveryRadiusKm                   Float     @default(1500)
  driverSearchRadiusKm                  Float     @default(5.0)
  driverSearchRadiusStepKm              Float     @default(2.0)
  driverSearchRadiusMaxKm               Float     @default(15.0)
  autoCancelPendingMins                 Int       @default(15)
  mobileWalletTimeoutMins               Int       @default(15)
  driverAcceptTimeoutSecs               Int       @default(30)
  assistDecisionTimeoutSecs             Int       @default(120)
  isMaintenanceMode                     Boolean   @default(false)
  androidMinVersion                     String    @default("1.0.0")
  androidLatestVersion                  String    @default("1.0.0")
  androidForceUpdate                    Boolean   @default(false)
  androidStoreUrl                       String?
  iosMinVersion                         String    @default("1.0.0")
  iosLatestVersion                      String    @default("1.0.0")
  iosForceUpdate                        Boolean   @default(false)
  iosStoreUrl                           String?
  supportEmail                          String?
  supportPhone                          String?
  supportWhatsapp                       String?
  termsUrl                              String?
  privacyUrl                            String?
  homeCoverUrl                          String?
  motorcycleIconUrl                     String?
  carIconUrl                            String?
  bicycleIconUrl                        String?
  motorTricycleIconUrl                  String?
  vanIconUrl                            String?
  truckIconUrl                          String?
  deliveryBannerIconUrl                 String?
  retentionOrdersDays                   Int       @default(90)
  retentionArchivedChatsDays            Int       @default(60)
  retentionNotificationsDays            Int       @default(30)
  retentionExpiredSessionsDays          Int       @default(7)
  retentionAuditLogsDays                Int       @default(180)
  retentionAbandonedCartsDays           Int       @default(7)
  retentionPaymentReceiptsDays          Int       @default(90)
  retentionShiftStartPhotosDays         Int       @default(30)
  retentionPickupPhotosDays             Int       @default(90)
  retentionDeliveryPhotosDays           Int       @default(90)
  retentionWalletTransactionsDays       Int       @default(365)
  retentionStatisticsDays               Int       @default(365)
  maxKmForBicycle                       Float     @default(5.0)
  driverSearchMaxAttempts               Int       @default(5)
  driverSearchGeoCandidateLimit         Int       @default(200)
  driverLocationFreshnessTtlSecs        Int       @default(30)
  driverLocationPrecisionMeters         Int       @default(0)
  fallbackOrderDistanceKm               Float     @default(3.0)
  // ─── Smart multi-vendor delivery grouping (kilometres) ──────────────────
  // Max straight-line distance between any two vendor branches that may share
  // one delivery group.
  groupingMaxBranchDistanceKm           Float     @default(5.0)
  // Max straight-line distance from a vendor branch to the customer drop-off
  // for that branch to be eligible for grouping at all.
  groupingMaxVendorCustomerDistanceKm   Float     @default(25.0)
  customOrderPlatformFee                Int       @default(10)
  maxDispatchBatchSize                  Int       @default(20)
  maxActiveOrdersPerDriver              Int       @default(1)
  stackedOrderDriverPercentage          Int       @default(50)
  batchMaxVendorDistanceKm              Float     @default(2.0)
  batchMaxCustomerDistanceKm            Float     @default(2.5)
  coinValue                             Int       @default(1)
  amountSpentPerCoin                    Int       @default(10)
  minCoinsToUse                         Int       @default(1)
  driverBonusActive                     Boolean   @default(false)
  driverBonusAmount                     Int       @default(0)
  driverBonusStartDate                  DateTime? @db.Timestamptz(3)
  driverBonusEndDate                    DateTime? @db.Timestamptz(3)
  driverBonusPaidByCustomer             Boolean   @default(false)
  driverShiftsEnabled                   Boolean   @default(false)
  breaksEnabled                         Boolean   @default(true)
  maxActiveOrdersPerCustomer            Int       @default(2)
  requirePriorDeliveryForMultipleOrders Boolean   @default(true)
  maxOtpAttempts                        Int       @default(5)
  maxNegativeDriverBalance              Int       @default(500)
  driverSettlementOrderThreshold        Int       @default(10)
  maxBreakMinutesPerShift               Int       @default(60)
  maxBreaksPerShift                     Int       @default(2)
  maxSingleBreakMinutes                 Int       @default(30)
  pendingBreakExpiryMins                Int       @default(15)
  otpExpirySeconds                      Int       @default(900)
  bronzeTierBonusPerKm                  Int       @default(0)
  silverTierBonusPerKm                  Int       @default(0)
  goldTierBonusPerKm                    Int       @default(0)
  highValueOrderThreshold               Int       @default(0)
  highValueUpfrontRate                  Int       @default(0)
  updatedAt                             DateTime  @updatedAt @db.Timestamptz(3)

  @@map("platform_settings")
}

model Zone {
  id                      String                  @id @default(uuid())
  name                    String
  nameAr                  String?
  boundary                Unsupported("geometry")
  isActive                Boolean                 @default(true)
  baseDeliveryFeeOverride Int?
  minOrderAmountOverride  Int?
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)
  driverShifts            DriverShift[]
  orders                  Order[]
  vendorBranches          VendorBranch[]
  shiftPools              ShiftPool[]
  driverManagers          DriverManager[]

  @@index([isActive])
  @@index([boundary], type: Gist)
  @@map("zones")
}

model User {
  id                   String                    @id @default(uuid())
  email                String?                   // uniqueness enforced by partial index (deletedAt IS NULL) via migration
  phone                String?                   // uniqueness enforced by partial index (deletedAt IS NULL) via migration
  password             String?
  name                 String
  role                 Role                      @default(CUSTOMER)
  title                String?
  titleAr              String?
  permissions          Permission[]
  avatar               String?
  language             Language                  @default(EN)
  isEmailVerified      Boolean                   @default(false)
  isPhoneVerified      Boolean                   @default(false)
  isBanned             Boolean                   @default(false)
  banReason            String?
  autoReplyMessage     String?
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?                 @db.Timestamptz(3)
  auditLogs            AuditLog[]
  conversations        ConversationParticipant[]
  customer             Customer?
  devices              Device[]
  driver               Driver?
  driverManager        DriverManager?
  messages             Message[]
  notificationSettings NotificationSetting?
  notifications        Notification[]
  sessions             Session[]
  assignedTickets      SupportTicket[]           @relation("TicketAssignee")
  createdTickets       SupportTicket[]           @relation("TicketCreator")
  vendorMemberships    VendorMember[]
  createdConversations Conversation[]            @relation("ConversationCreator")
  approvedTopUps       WalletTopUpRequest[]
  approvedDrivers      Driver[]                  @relation("DriverApprovals")
  accounts             Account[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Device {
  id         String         @id @default(uuid())
  token      String         @unique
  platform   DevicePlatform
  userId     String
  lastActive DateTime       @default(now()) @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@index([lastActive])
  @@map("devices")
}

model Session {
  id        String     @id @default(uuid())
  userId    String
  hashedRt  String
  ipAddress String?
  userAgent String?
  expiresAt DateTime   @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  titleAr   String?
  body      String?
  bodyAr    String?
  type      NotificationType
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationSetting {
  id            String   @id @default(uuid())
  userId        String   @unique
  pushEnabled   Boolean  @default(true)
  orderUpdates  Boolean  @default(true)
  chatMessages  Boolean  @default(true)
  promotions    Boolean  @default(true)
  system        Boolean  @default(true)
  ticketUpdates Boolean  @default(true)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model Conversation {
  id            String                    @id @default(uuid())
  type          ConversationType          @default(ORDER)
  orderId       String?
  order         Order?                    @relation(fields: [orderId], references: [id])
  status        ConversationStatus        @default(OPEN)
  vendorId      String?
  creatorId     String?
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?                 @db.Timestamptz(3)
  participants  ConversationParticipant[]
  creator       User?                     @relation("ConversationCreator", fields: [creatorId], references: [id])
  vendor        Vendor?                   @relation(fields: [vendorId], references: [id])
  messages      Message[]
  supportTicket SupportTicket?

  @@index([orderId])
  @@index([vendorId])
  @@index([creatorId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now()) @db.Timestamptz(3)
  lastReadAt     DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
  @@index([lastReadAt])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  text           String?
  mediaUrl       String?
  metadata       Json?
  replyToId      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime?    @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("MessageReplies")
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

model SupportTicket {
  id                 String         @id @default(uuid())
  ticketNumber       String         @unique @default(dbgenerated("'TKT-'::text || nextval('ticket_number_seq'::regclass)"))
  subject            String
  description        String?
  status             TicketStatus   @default(OPEN)
  category           TicketCategory @default(OTHER)
  subCategory        String?
  priority           TicketPriority @default(MEDIUM)
  creatorId          String
  assigneeId         String?
  orderId            String?
  vendorId           String?
  conversationId     String?        @unique
  lastStatusUpdateAt DateTime       @default(now()) @db.Timestamptz(3)
  escalatedAt        DateTime?      @db.Timestamptz(3)
  metadata           Json?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  assignee           User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  conversation       Conversation?  @relation(fields: [conversationId], references: [id])
  creator            User           @relation("TicketCreator", fields: [creatorId], references: [id])
  order              Order?         @relation(fields: [orderId], references: [id])
  vendor             Vendor?        @relation(fields: [vendorId], references: [id])

  @@index([creatorId])
  @@index([assigneeId])
  @@index([vendorId])
  @@index([status])
  @@index([orderId])
  @@map("support_tickets")
}

model Customer {
  id               String                    @id @default(uuid())
  userId           String                    @unique
  canOrder         Boolean                   @default(true)
  deletedAt        DateTime?                 @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)
  coinBalance      Int                       @default(0)
  addresses        Address[]
  carts            Cart[]
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteProducts FavoriteProduct[]
  favoriteVendors  FavoriteVendor[]
  orders           Order[]
  coinTransactions CustomerCoinTransaction[]
  orderReviews     OrderReview[]

  @@index([createdAt])
  @@index([deletedAt])
  @@map("customers")
}

enum CoinTransactionType {
  EARNED
  SPENT
  REFUNDED
}

model CustomerCoinTransaction {
  id           String              @id @default(uuid())
  customerId   String
  orderId      String?
  type         CoinTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([orderId])
  @@unique([orderId, type])
  @@map("customer_coin_transactions")
}

model FavoriteVendor {
  id         String   @id @default(uuid())
  customerId String
  vendorId   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId])
  @@map("favorite_vendors")
}

model FavoriteProduct {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@map("favorite_products")
}

model Address {
  id         String                  @id @default(uuid())
  label      String                  @default("Home")
  address    String
  location   Unsupported("geometry")
  details    String?
  isDefault  Boolean                 @default(false)
  customerId String
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(3)
  customer   Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([location], type: Gist)
  @@map("addresses")
}

model VendorVertical {
  id        String   @id @default(uuid())
  name      String
  nameAr    String?
  slug      String   @unique
  iconUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  vendors   Vendor[]

  @@index([isActive, sortOrder])
  @@map("vendor_verticals")
}

model Vendor {
  id                 String                    @id @default(uuid())
  storeName          String
  storeNameAr        String?
  slug               String                    @unique
  description        String?
  descriptionAr      String?
  logo               String?
  coverImage         String?
  phone              String?
  taxId              String?
  rating             Float                     @default(0)
  ratingCount        Int                       @default(0)
  commissionRate     Int                       @default(10)
  status             VendorStatus              @default(CLOSED)
  // Vendor-owned wallet. Every VendorMember reads this same balance and ledger.
  walletBalance      Int                       @default(0)
  isContracted       Boolean                   @default(false)
  workingHours       Json?
  isScheduleActive   Boolean                   @default(true)
  is24Hours          Boolean                   @default(false)
  verticalId         String
  deletedAt          DateTime?                 @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  auditLogs          AuditLog[]
  carts              Cart[]
  conversations      Conversation[]
  favoritedBy        FavoriteVendor[]
  categories         MenuCategory[]
  orders             Order[]
  products           Product[]
  supportTickets     SupportTicket[]
  branches           VendorBranch[]
  members            VendorMember[]
  statistics         VendorStatistic[]
  walletTransactions VendorWalletTransaction[]
  promotions         Promotion[]
  offers             Offer[]
  orderReviews       OrderReview[]
  vertical           VendorVertical            @relation(fields: [verticalId], references: [id])

  orderFulfillments OrderVendorFulfillment[]
  @@index([createdAt])
  @@index([status])
  @@index([verticalId])
  @@index([deletedAt])
  @@map("vendors")
}

model VendorMember {
  id        String           @id @default(uuid())
  vendorId  String
  userId    String
  role      VendorMemberRole @default(STAFF)
  branchId  String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branch    VendorBranch?    @relation(fields: [branchId], references: [id])

  @@unique([vendorId, userId])
  @@index([userId])
  @@index([branchId])
  @@map("vendor_members")
}

model VendorBranch {
  id        String                  @id @default(uuid())
  name      String
  nameAr    String?
  address   String
  phone     String?
  isOpen    Boolean                 @default(true)
  isContracted Boolean?
  commissionRate Int?
  location  Unsupported("geometry")
  vendorId  String
  zoneId    String
  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @db.Timestamptz(3)
  vendor    Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  zone      Zone                    @relation(fields: [zoneId], references: [id])

  vendorMembers VendorMember[]
  orders        Order[]

  orderFulfillments    OrderVendorFulfillment[]
  productAvailability  ProductBranchAvailability[]
  categoryAvailability CategoryBranchAvailability[]

  @@index([zoneId])
  @@index([vendorId, isOpen])
  @@index([location], type: Gist)
  @@map("vendor_branches")
}

// Vendor-owned ledger. Rows are scoped by vendorId; there is no member/user
// wallet. All members of the vendor see the same history.
model VendorWalletTransaction {
  id           String                @id @default(uuid())
  vendorId     String
  orderId      String?
  type         VendorTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  referenceId  String?
  idempotencyKey String?
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  order        Order?                @relation(fields: [orderId], references: [id])
  vendor       Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Was @@unique([orderId, type]) — that capped an order at ONE revenue + ONE
  // commission row and made per-vendor settlement impossible. Scoped to
  // vendorId so each vendor portion settles exactly once per order.
  @@unique([orderId, type, vendorId])
  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, createdAt])
  @@index([vendorId, type, createdAt])
  @@index([orderId])
  @@index([createdAt])
  @@map("vendor_wallet_transactions")
}

model VendorStatistic {
  id              String          @id @default(uuid())
  vendorId        String
  period          StatisticPeriod
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  totalOrders     Int             @default(0)
  totalRevenue    Int             @default(0)
  totalCommission Int             @default(0)
  totalTax        Int             @default(0)
  completedOrders Int             @default(0)
  cancelledOrders Int             @default(0)
  avgPrepTimeMins Float?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, period, startDate])
  @@index([startDate, endDate])
  @@map("vendor_statistics")
}

model AppStatistic {
  id                String          @id @default(uuid())
  period            StatisticPeriod
  startDate         DateTime        @db.Date
  endDate           DateTime        @db.Date
  totalOrders       Int             @default(0)
  totalAdminRevenue Int             @default(0)
  totalDeliveryFees Int             @default(0)
  activeCustomers   Int             @default(0)
  activeDrivers     Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([period, startDate])
  @@index([startDate, endDate])
  @@map("app_statistics")
}

/**
 * Exactly-once guard for async stat updates (DB-anchored idempotency).
 * Each stats job carries a deterministic `sourceKey` derived from its
 * underlying event (e.g. `settle:<orderId>:UPDATE_VENDOR`). The worker CREATEd
 * the marker row and applies the `+=` upserts in the SAME DB transaction, so a
 * re-delivered job (worker crash, stall, manual retry) finds an existing
 * sourceKey and skips — no double-count, no extra store, atomic with the data.
 * Purged by the stats retention job once older than retentionStatisticsDays.
 */
model StatProcessingMarker {
  sourceKey String   @id @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@map("stat_processing_markers")
}

model MenuCategory {
  id            String    @id @default(uuid())
  vendorId      String
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  iconUrl       String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products      Product[]
  branchAvailabilityMode ProductBranchAvailabilityMode @default(ALL)
  branchAvailability     CategoryBranchAvailability[]

  @@index([vendorId, isActive])
  @@map("menu_categories")
}

// ALL means every current and future branch; SPECIFIC resolves through explicit rows below.
model CategoryBranchAvailability {
  categoryId String
  branchId   String
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  branch     VendorBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([categoryId, branchId])
  @@index([branchId, categoryId])
  @@map("category_branch_availability")
}

enum ProductBranchAvailabilityMode {
  ALL
  SPECIFIC
}

model Product {
  id               String               @id @default(uuid())
  version          Int                  @default(100)
  vendorId         String
  categoryId       String?
  name             String
  nameAr           String?
  description      String?
  descriptionAr    String?
  imageUrl         String?
  sellByStrip      Boolean              @default(false)
  stripsPerPackage Int?
  hasVariants      Boolean              @default(false)
  basePrice        Int?
  comparePrice     Int?
  sku              String?              @unique
  stock            Int?
  tracksStock      Boolean              @default(true)
  isActive         Boolean              @default(true)
  isFeatured       Boolean              @default(false)
  deletedAt        DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  cartItems        CartItem[]
  favoritedBy      FavoriteProduct[]
  orderItems       OrderItem[]
  optionGroups     ProductOptionGroup[]
  variants         ProductVariant[]
  promotions       Promotion[]
  offers           Offer[]
  branchAvailabilityMode ProductBranchAvailabilityMode @default(ALL)
  branchAvailability     ProductBranchAvailability[]
  category         MenuCategory?        @relation(fields: [categoryId], references: [id])
  vendor           Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, isActive, isFeatured])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("products")
}

// ALL means every current and future branch; SPECIFIC resolves through the
// explicit rows below. A one-branch product is simply SPECIFIC with one row.
model ProductBranchAvailability {
  productId String
  branchId  String
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch    VendorBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([productId, branchId])
  @@index([branchId, productId])
  @@map("product_branch_availability")
}

model ProductVariant {
  id           String               @id @default(uuid())
  productId    String
  name         String
  nameAr       String?
  sku          String?              @unique
  basePrice    Int
  comparePrice Int?
  stock        Int?
  tracksStock  Boolean              @default(true)
  isActive     Boolean              @default(true)
  version      Int                  @default(100)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  optionGroups ProductOptionGroup[]
  offers       Offer[]
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductOptionGroup {
  id         String          @id @default(uuid())
  productId  String?
  variantId  String?
  name       String
  nameAr     String?
  isRequired Boolean         @default(false)
  minSelect  Int             @default(0)
  maxSelect  Int             @default(100)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  options    ProductOption[]

  @@index([productId])
  @@index([variantId])
  @@map("product_option_groups")
}

model ProductOption {
  id               String             @id @default(uuid())
  groupId          String
  name             String
  nameAr           String?
  priceAdded       Int                @default(0)
  isActive         Boolean            @default(true)
  cartItemOptions  CartItemOption[]
  orderItemOptions OrderItemOption[]
  group            ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("product_options")
}

model Cart {
  id         String     @id @default(uuid())
  customerId String
  vendorId   String
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)
  items      CartItem[]
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId])
  @@index([customerId])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id              String           @id @default(uuid())
  cartId          String
  productId       String?
  variantId       String?
  customName      String?
  customPrice     Int?
  customImageUrl  String?
  quantity        Int              @default(1)
  selectedUnit    String           @default("package")
  specialRequest  String?
  optionHash      String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  selectedOptions CartItemOption[]
  cart            Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // NOTE: concurrent-addItem merge is guarded by two partial unique indexes
  // ("cart_items_product_merge_uidx" / "cart_items_custom_merge_uidx") defined
  // in raw migration SQL. PSL cannot express filtered / COALESCE indexes, so
  // they intentionally do not appear here and `prisma migrate dev` flags drift.
  @@map("cart_items")
}

model CartItemOption {
  id         String        @id @default(uuid())
  cartItemId String
  optionId   String
  cartItem   CartItem      @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  option     ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@map("cart_item_options")
}

model Order {
  id                   String                    @id @default(uuid())
  orderNumber          String                    @unique @default(dbgenerated("'ORD-'::text || nextval('order_number_seq'::regclass)"))
  clientOrderKey       String?                   @unique
  type                 OrderType                 @default(STANDARD)
  customerId           String
  vendorId             String?
  vendorBranchId       String?
  driverId             String?
  zoneId               String?
  driverShiftId        String?
  // Assisted delivery (single-vendor orders): an extra driver helps the
  // primary. Mirrors OrderDeliveryGroup's assist fields.
  assistDriverId       String?
  assistDriverShiftId  String?
  assistFee            Int?
  assistCustomerApproved Boolean?
  assistApprovedAt     DateTime?                 @db.Timestamptz(3)
  isStacked            Boolean                   @default(false)
  status               OrderStatus               @default(PENDING)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus             @default(PENDING)
  deliveryAddress      String
  deliveryLocation     Unsupported("geometry")
  pickupAddress        String?
  pickupLocation       Unsupported("geometry")?
  itemDetails          String?
  requestedVehicleType VehicleType?
  subtotal             Int
  deliveryFee          Int
  driverBonusFee       Int                       @default(0)
  serviceFee           Int
  tax                  Int
  discount             Int                       @default(0)
  coinsUsed            Int                       @default(0)
  coinsEarned          Int                       @default(0)
  grandTotal           Int
  upfrontAmount        Int                       @default(0)
  specialRequest       String?
  estimatedPrepTime    Int?
  distanceKm           Float?
  deletedAt            DateTime?                 @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  acceptedAt           DateTime?                 @db.Timestamptz(3)
  preparedAt           DateTime?                 @db.Timestamptz(3)
  driverAssignedAt     DateTime?                 @db.Timestamptz(3)
  pickedUpAt           DateTime?                 @db.Timestamptz(3)
  pickupImageUrl       String?
  deliveryImageUrl     String?
  paymentReceiptUrl    String?
  actualDeliveryTime   DateTime?                 @db.Timestamptz(3)
  settledAt            DateTime?                 @db.Timestamptz(3)
  driverTransactions   DriverWalletTransaction[]
  driverManagerTransactions DriverManagerWalletTransaction[]
  dispatches           OrderDispatch[]
  items                OrderItem[]
  statusEvents         OrderStatusEvent[]
  customer             Customer                  @relation(fields: [customerId], references: [id])
  driver               Driver?                   @relation(fields: [driverId], references: [id])
  driverShift          DriverShift?              @relation(fields: [driverShiftId], references: [id])
  assistDriver         Driver?                   @relation("OrderAssistDriver", fields: [assistDriverId], references: [id])
  assistDriverShift    DriverShift?              @relation("OrderAssistShift", fields: [assistDriverShiftId], references: [id])
  vendor               Vendor?                   @relation(fields: [vendorId], references: [id])
  vendorBranch         VendorBranch?             @relation(fields: [vendorBranchId], references: [id])
  zone                 Zone?                     @relation(fields: [zoneId], references: [id])
  supportTickets       SupportTicket[]
  conversations        Conversation[]
  vendorTransactions   VendorWalletTransaction[]
  review               OrderReview?
  // ─── Multi-vendor / grouped delivery (additive) ─────────────────────────
  vendorFulfillments   OrderVendorFulfillment[]
  deliveryGroups       OrderDeliveryGroup[]
  assistRequests       DriverAssistRequest[]

  @@index([customerId])
  @@index([zoneId])
  @@index([vendorId, status])
  @@index([driverId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([customerId, createdAt])
  @@index([vendorId, createdAt])
  @@index([driverId, createdAt])
  @@index([customerId, status])
  @@index([deliveryLocation], type: Gist)
  @@index([pickupLocation], type: Gist)
  @@map("orders")
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model OrderItem {
  id              String            @id @default(uuid())
  orderId         String
  // Set when the item belongs to a specific vendor portion of a multi-vendor
  // order. Null for legacy single-vendor rows and custom-delivery/ride orders.
  fulfillmentId   String?
  productId       String?
  variantId       String?
  productName     String
  variantName     String?
  unitPrice       Int
  quantity        Int
  totalPrice      Int
  specialRequest  String?
  selectedUnit    String?
  baseUnitPrice   Int?
  // Auditable rejection marker: the row is never deleted so the audit trail and
  // the original price snapshot survive.
  rejectedAt      DateTime?         @db.Timestamptz(3)
  selectedOptions OrderItemOption[]
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillment     OrderVendorFulfillment? @relation(fields: [fulfillmentId], references: [id])
  product         Product?          @relation(fields: [productId], references: [id])
  variant         ProductVariant?   @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([fulfillmentId])
  @@map("order_items")
}

model OrderItemOption {
  id          String         @id @default(uuid())
  orderItemId String
  optionId    String?
  optionName  String
  groupName   String?
  priceAdded  Int
  option      ProductOption? @relation(fields: [optionId], references: [id])
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_options")
}

/// One vendor's independently-fulfillable portion of a customer order. This is
/// the unit that accepts/rejects, settles, and gets picked up in a delivery.
model OrderVendorFulfillment {
  id             String                    @id @default(uuid())
  orderId        String
  vendorId       String
  vendorBranchId String?
  status         OrderVendorFulfillmentStatus @default(PENDING)
  /// Money snapshot for this vendor only (EGP, whole pounds) — the sum of its
  /// non-rejected items' totalPrice.
  subtotal       Int                       @default(0)
  /// Commission rate captured at checkout so settlement never re-reads a
  /// mutable vendor setting.
  commissionRate Int                       @default(10)
  rejectionCode  String?
  rejectionReason String?
  rejectionReasonAr String?
  decidedByUserId String?
  decidedAt      DateTime?                 @db.Timestamptz(3)
  /// When THIS portion entered production. Per-portion on purpose: several
  /// vendors can share one delivery, so one vendor starting to cook must not
  /// make another vendor's portion look like it is being prepared.
  preparingAt    DateTime?                 @db.Timestamptz(3)
  /// When THIS portion was declared ready for pickup. The shared delivery
  /// group only becomes READY_FOR_PICKUP once every live portion in it is ready.
  readyAt        DateTime?                 @db.Timestamptz(3)
  /// Proof photo the driver uploaded when picking up this specific vendor portion.
  pickupImageUrl String?
  /// When the driver confirmed collection of this vendor portion.
  pickedUpAt     DateTime?                 @db.Timestamptz(3)
  /// Driver who confirmed collection of this vendor portion.
  pickedUpByDriverId String?
  deliveredAt    DateTime?                 @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)

  order      Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor     Vendor                    @relation(fields: [vendorId], references: [id])
  vendorBranch VendorBranch?           @relation(fields: [vendorBranchId], references: [id])
  items      OrderItem[]
  groups     OrderDeliveryGroupItem[]

  @@index([orderId])
  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("order_vendor_fulfillments")
}

/// A single physical delivery of a customer order: one primary driver, one or
/// more vendor fulfillments, one customer drop-off.
model OrderDeliveryGroup {
  id             String                    @id @default(uuid())
  orderId        String
  sequence       Int                       @default(1)
  status         DeliveryGroupStatus       @default(PENDING)
  primaryDriverId String?
  primaryDriverShiftId String?
  assistDriverId String?
  assistDriverShiftId String?
  /// Fee (minor units) the customer is charged for the assisting driver.
  /// Null until an assistant is assigned; set at assignment time.
  assistFee Int?
  /// Customer's decision on the assisted delivery (and its fee).
  /// null = not yet decided, true = approved (customer pays), false = declined.
  assistCustomerApproved Boolean?
  assistApprovedAt DateTime? @db.Timestamptz(3)
  isStacked      Boolean                   @default(false)
  assignedByUserId String?
  assignedAt     DateTime?                 @db.Timestamptz(3)
  distanceKm     Float?
  deliveryFee    Int                       @default(0)
  estimatedPrepTime Int?
  /// Proof photo this delivery's own driver uploaded at pickup. Stored per
  /// delivery (not on the order) so one delivery's proof can never satisfy
  /// another delivery's photo requirement.
  pickupImageUrl String?
  /// Proof photo this delivery's own driver uploaded at drop-off.
  deliveryImageUrl String?
  pickedUpAt     DateTime?                 @db.Timestamptz(3)
  deliveredAt    DateTime?                 @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)

  order        Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  primaryDriver Driver?                   @relation("GroupPrimaryDriver", fields: [primaryDriverId], references: [id])
  primaryDriverShift DriverShift?         @relation("GroupPrimaryShift", fields: [primaryDriverShiftId], references: [id])
  assistDriver Driver?                    @relation("GroupAssistDriver", fields: [assistDriverId], references: [id])
  assistDriverShift DriverShift?          @relation("GroupAssistShift", fields: [assistDriverShiftId], references: [id])
  items       OrderDeliveryGroupItem[]
  assistRequests DriverAssistRequest[]
  dispatches  OrderDispatch[]

  @@unique([orderId, sequence])
  @@index([orderId])
  @@index([primaryDriverId])
  @@index([status])
  @@map("order_delivery_groups")
}

/// Join table: which vendor fulfillments ride together in a delivery group.
model OrderDeliveryGroupItem {
  deliveryGroupId String
  fulfillmentId   String
  sequence        Int                       @default(1)
  deliveryGroup   OrderDeliveryGroup        @relation(fields: [deliveryGroupId], references: [id], onDelete: Cascade)
  fulfillment     OrderVendorFulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@id([deliveryGroupId, fulfillmentId])
  /// A vendor portion rides in exactly one delivery — unique so it can never be
  /// dispatched twice by two groups.
  @@unique([fulfillmentId])
  @@map("order_delivery_group_items")
}

/// Persisted driver request for a second pair of hands. Mirrors the
/// DriverBreak request/approve/reject precedent, including a partial unique
/// index (SQL-only) that makes duplicate open requests impossible.
model DriverAssistRequest {
  id             String                    @id @default(uuid())
  driverId       String
  orderId        String
  deliveryGroupId String?
  reason         DriverAssistReason       @default(OTHER)
  note           String?
  status         DriverAssistRequestStatus @default(PENDING)
  assignedDriverId String?
  reviewedByUserId String?
  reviewedAt     DateTime?                 @db.Timestamptz(3)
  resolvedAt     DateTime?                 @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)

  driver          Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryGroup   OrderDeliveryGroup? @relation(fields: [deliveryGroupId], references: [id])
  assignedDriver  Driver?             @relation("AssistAssignedDriver", fields: [assignedDriverId], references: [id])

  @@index([orderId])
  @@index([driverId, createdAt])
  @@index([status, createdAt])
  @@index([deliveryGroupId])
  @@map("driver_assist_requests")
}

model Driver {
  id                  String                    @id @default(uuid())
  userId              String                    @unique
  name                String
  avatar              String?
  nationalId          String?
  licenseNumber       String?
  vehicleType         VehicleType               @default(MOTORCYCLE)
  vehiclePlate        String?
  tier                DriverTier                @default(SILVER)
  status              DriverStatus              @default(OFFLINE)
  lastLocation        Unsupported("geometry")?
  lastLocationUpdate  DateTime?                 @db.Timestamptz(3)
  rating              Int                       @default(500)
  ratingCount         Int                       @default(0)
  totalOrders         Int                       @default(0)
  ordersSinceSettlement Int                    @default(0)
  walletBalance       Int                       @default(0)
  hasUnpaidCommission Boolean                   @default(false)
  version             Int                       @default(100)
  deletedAt           DateTime?                 @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  shifts              DriverShift[]
  statistics          DriverStatistic[]
  walletTransactions  DriverWalletTransaction[]
  mobileWallets       MobileWallet[]
  topUps              WalletTopUpRequest[]
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isApproved          Boolean                   @default(false)
  approvedAt          DateTime?                 @db.Timestamptz(3)
  approvedById        String?
  approvedBy          User?                     @relation("DriverApprovals", fields: [approvedById], references: [id])
  dispatches          OrderDispatch[]
  orders              Order[]
  assistedOrders      Order[]                   @relation("OrderAssistDriver")
  orderReviews        OrderReview[]
  breaks              DriverBreak[]

  primaryGroups    OrderDeliveryGroup[] @relation("GroupPrimaryDriver")
  assistGroups     OrderDeliveryGroup[] @relation("GroupAssistDriver")
  assistRequests   DriverAssistRequest[]
  assignedAssistRequests DriverAssistRequest[] @relation("AssistAssignedDriver")
  shiftWaitlist          ShiftPoolWaitlist[]
  managerAssignment DriverManagerAssignment?
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("drivers")
}

model DriverShift {
  id                 String                    @id @default(uuid())
  driverId           String
  shiftPoolId        String?
  zoneId             String?
  shiftDate          DateTime                  @db.Timestamptz(3)
  startTime          DateTime                  @db.Timestamptz(3)
  endTime            DateTime                  @db.Timestamptz(3)
  actualStart        DateTime?                 @db.Timestamptz(3)
  actualEnd          DateTime?                 @db.Timestamptz(3)
  startPhotoUrl      String?
  startingLocation   Unsupported("geometry")?
  endingLocation     Unsupported("geometry")?
  status             DriverShiftStatus         @default(SCHEDULED)
  breakMinutes       Int?
  totalEarnings      Int?
  totalDeliveries    Int?
  expiredDispatches  Int                       @default(0)
  rejectedDispatches Int                       @default(0)
  warningSent        Boolean                   @default(false)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  driver             Driver                    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shiftPool          ShiftPool?                @relation(fields: [shiftPoolId], references: [id])
  zone               Zone?                     @relation(fields: [zoneId], references: [id])
  walletTransactions DriverWalletTransaction[]
  dispatches         OrderDispatch[]
  orders             Order[]
  assistedOrders     Order[]                   @relation("OrderAssistShift")
  swapRequests       ShiftSwapRequest[]
  breaks             DriverBreak[]

  primaryGroups    OrderDeliveryGroup[] @relation("GroupPrimaryShift")
  assistGroups     OrderDeliveryGroup[] @relation("GroupAssistShift")
  @@index([shiftPoolId])
  @@index([zoneId])
  @@index([driverId, status])
  @@index([shiftDate])
  @@index([status])
  @@index([startingLocation], type: Gist)
  @@index([endingLocation], type: Gist)
  @@map("driver_shifts")
}

model ShiftPool {
  id           String        @id @default(uuid())
  batchId      String?
  title        String?
  titleAr      String?
  zoneId       String?
  shiftDate    DateTime      @db.Date
  startTime    DateTime      @db.Timestamptz(3)
  endTime      DateTime      @db.Timestamptz(3)
  maxDrivers   Int
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  zone         Zone?         @relation(fields: [zoneId], references: [id])
  driverShifts DriverShift[]
  waitlist     ShiftPoolWaitlist[]

  @@index([shiftDate])
  @@index([zoneId])
  @@index([batchId])
  @@map("shift_pools")
}

model ShiftPoolWaitlist {
  id          String    @id @default(uuid())
  shiftPoolId String
  driverId    String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  shiftPool ShiftPool @relation(fields: [shiftPoolId], references: [id], onDelete: Cascade)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([shiftPoolId, driverId])
  @@index([shiftPoolId, createdAt])
  @@map("shift_pool_waitlist")
}

model ShiftSwapRequest {
  id                String            @id @default(uuid())
  driverShiftId     String            @unique
  offeredByDriverId String
  status            SwapRequestStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  driverShift DriverShift @relation(fields: [driverShiftId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([offeredByDriverId])
  @@map("shift_swap_requests")
}

model DriverManager {
  id                 String                      @id @default(uuid())
  userId             String                      @unique
  zoneId             String?
  walletBalance      Int                         @default(0)
  manageAllDrivers   Boolean                     @default(false)
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(3)
  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone               Zone?                       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  walletTransactions DriverManagerWalletTransaction[]
  assignedDrivers    DriverManagerAssignment[]

  @@index([zoneId])
  @@map("driver_managers")
}

model DriverManagerAssignment {
  id              String        @id @default(uuid())
  driverManagerId String
  driverId        String        @unique
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  driverManager   DriverManager @relation(fields: [driverManagerId], references: [id], onDelete: Cascade)
  driver          Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverManagerId, driverId])
  @@index([driverManagerId])
  @@map("driver_manager_assignments")
}

model DriverManagerWalletTransaction {
  id             String                      @id @default(uuid())
  managerId      String
  orderId        String?
  type           DriverManagerTransactionType
  amount         Int
  balanceAfter   Int
  description    String?
  referenceId    String?
  idempotencyKey String?
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)
  manager        DriverManager               @relation(fields: [managerId], references: [id], onDelete: Cascade)
  order          Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, type, managerId])
  @@unique([managerId, idempotencyKey])
  @@index([managerId, createdAt])
  @@index([orderId])
  @@map("driver_manager_wallet_transactions")
}

model DriverWalletTransaction {
  id            String                @id @default(uuid())
  driverId      String
  orderId       String?
  driverShiftId String?
  type          WalletTransactionType
  amount        Int
  balanceAfter  Int
  description   String?
  referenceId   String?
  idempotencyKey String?
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  driver        Driver                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverShift   DriverShift?          @relation(fields: [driverShiftId], references: [id])
  order         Order?                @relation(fields: [orderId], references: [id])

  @@index([driverId])
  @@index([orderId])
  @@index([createdAt])
  @@index([driverShiftId])
  // Was @@unique([orderId, type]) — that capped an order at ONE DELIVERY_FEE row
  // each driver on a delivery is paid exactly once per order+type.
  @@unique([orderId, type, driverId])
  @@unique([driverId, idempotencyKey])
  @@map("driver_wallet_transactions")
}

model DriverStatistic {
  id                      String          @id @default(uuid())
  driverId                String
  period                  StatisticPeriod
  startDate               DateTime        @db.Date
  endDate                 DateTime        @db.Date
  totalOrders             Int             @default(0)
  totalEarnings           Int             @default(0)
  completedOrders         Int             @default(0)
  cancelledOrders         Int             @default(0)
  onlineHours             Float?
  totalDispatchesReceived Int             @default(0)
  dispatchesAccepted      Int             @default(0)
  dispatchesRejected      Int             @default(0)
  dispatchesExpired       Int             @default(0)
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(3)
  driver                  Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, period, startDate])
  @@index([startDate, endDate])
  @@map("driver_statistics")
}

model OrderDispatch {
  id                String         @id @default(uuid())
  orderId           String
  // Which delivery this offer is for. Null for legacy single-vendor orders and
  // CUSTOM_DELIVERY/RIDE, where the order itself is the only delivery.
  deliveryGroupId   String?
  driverId          String
  driverShiftId     String?
  type              OrderType      @default(STANDARD)
  status            DispatchStatus @default(PENDING)
  distanceKm        Float?
  estimatedEarnings Int?
  expiresAt         DateTime       @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  driver            Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverShift       DriverShift?   @relation(fields: [driverShiftId], references: [id])
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryGroup     OrderDeliveryGroup? @relation(fields: [deliveryGroupId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([deliveryGroupId])
  @@index([driverId])
  @@index([driverShiftId])
  @@index([status])
  @@index([createdAt])
  @@index([driverId, status])
  @@map("order_dispatches")
}

model AuditLog {
  id         String          @id @default(uuid())
  userId     String
  vendorId   String?
  actionType AuditActionType @default(OTHER)
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  sessionId  String?
  user       User            @relation(fields: [userId], references: [id])
  vendor     Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  session    Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([vendorId])
  @@index([actionType])
  @@index([entityType, entityId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("audit_logs")
}

model spatial_ref_sys {
