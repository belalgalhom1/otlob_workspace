model DriverBreak {
  id              String            @id @default(uuid())
  driverId        String
  shiftId         String?
  reason          DriverBreakReason @default(REST)
  // Free-text note from the driver (or admin on grant) — shown in the queue.
  note            String?
  // Driver-requested length in minutes. Watchdog caps it at
  // maxSingleBreakMinutes; null = up to the cap.
  requestedMinutes Int?
  status          DriverBreakStatus @default(PENDING)
  // Status before the break started — restored on end (pause/resume).
  prevStatus      DriverStatus?
  startedAt       DateTime          @default(now()) @db.Timestamptz(3)
  endedAt         DateTime?         @db.Timestamptz(3)
  durationMinutes Int?
  autoEnded       Boolean           @default(false)
  reviewedById    String?
  reviewedAt      DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  driver          Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shift           DriverShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([driverId, createdAt])
  @@index([shiftId])
  @@index([status])
  @@map("driver_breaks")
}

